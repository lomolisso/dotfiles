<!doctype html>
<!-- The new tab and home page: a terminal pane showing fastfetch and ls, then a
     prompt. Links are in start.js. -->
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>~/start</title>
<link rel="stylesheet" href="start.css">
</head>
<body>
<main class="pane">
  <span class="pane-title">~/start</span>
  <span class="pane-clock" id="pane-clock"></span>

  <p class="cmd"><span class="prompt">❯</span> fastfetch</p>
  <section class="fetch">
