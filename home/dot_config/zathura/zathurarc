# zathura, shin palette (matches waybar/rofi).
# Pages render as-is; press Ctrl+R to toggle dark recoloring (paper -> #000000,
# ink -> #e9e9e9). Embedded images (photos, PNG plots) keep their colors; figures
# drawn as vectors (most PDF plots, TikZ) are recolored like text, keeping hue.

set font "JetBrainsMono Nerd Font bold 10.5"
set selection-clipboard clipboard

set default-bg "#000000"
set default-fg "#e9e9e9"

set statusbar-bg "#1e1e1e"
set statusbar-fg "#e9e9e9"
set inputbar-bg "#000000"
set inputbar-fg "#e9e9e9"

set notification-bg "#1e1e1e"
set notification-fg "#e9e9e9"
set notification-error-bg "#1e1e1e"
set notification-error-fg "#cb4d66"
set notification-warning-bg "#1e1e1e"
set notification-warning-fg "#d5909e"

set completion-bg "#1e1e1e"
set completion-fg "#cfcfcf"
set completion-group-bg "#000000"
set completion-group-fg "#989898"
set completion-highlight-bg "#8c1625"
set completion-highlight-fg "#e9e9e9"

set index-bg "#000000"
set index-fg "#cfcfcf"
set index-active-bg "#8c1625"
set index-active-fg "#e9e9e9"

set highlight-color "rgba(203,77,102,0.35)"
set highlight-active-color "rgba(203,77,102,0.6)"
set highlight-fg "#e9e9e9"

set render-loading-bg "#000000"
set render-loading-fg "#989898"

set recolor false
set recolor-lightcolor "#000000"
set recolor-darkcolor "#e9e9e9"
set recolor-keephue true
set recolor-reverse-video true
