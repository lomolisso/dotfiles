# No GTK header bar or client-side frame; niri rounds the corners instead
# (see the corner window-rule in ~/.config/niri/config.kdl).
window-decoration = none

# fish as the interactive shell; the login shell ($SHELL) stays bash.
command = /usr/bin/fish

# Over ssh, install ghostty's terminfo on the remote host (or fall back to
# TERM=xterm-256color); without it backspace types a space there.
shell-integration-features = ssh-terminfo,ssh-env

# Colors from the wallpaper, generated by matugen (see ~/.config/matugen).
theme = matugen

# A little room between the text and the window border (default is 2px).
window-padding-x = 8
window-padding-y = 6

# Opaque true black for the OLED. Below 1, niri blurs and desaturates the wallpaper
# behind ghostty (window rule in ~/.config/niri/config.kdl).
background-opacity = 1
# Also for cells that set their own background (herdr, full-screen TUIs).
background-opacity-cells = true
