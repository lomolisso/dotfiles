# Generated by matugen from ~/.config/matugen/templates/ghostty. Don't edit;
# change the template and rerun matugen (command in ~/.config/matugen/config.toml).
# Look: true black and greys, the wallpaper's wine for red, neon for the other hues.

# True black for the OLED. (Frosted alternative: #121212 with background-opacity
# 0.8 in config.ghostty; niri's blur rule for ghostty is already in place.)
background = #000000
foreground = {{colors.on_surface.dark.hex | grayscale}}
cursor-color = {{colors.primary_container.dark.hex | set_lightness: 55.0 | set_saturation: 55.0}}
cursor-text = #000000
selection-background = {{colors.primary_container.dark.hex}}
selection-foreground = {{colors.on_surface.dark.hex | grayscale}}

# Greys: 0 black, 7 white, 8 bright black, 15 bright white.
palette = 0={{colors.surface_container_highest.dark.hex | grayscale}}
palette = 7={{colors.on_surface_variant.dark.hex | grayscale}}
palette = 8={{colors.outline.dark.hex | grayscale}}
palette = 15={{colors.on_surface.dark.hex | grayscale}}

# Red is the wallpaper's wine, lifted so it reads on black.
palette = 1={{colors.primary_container.dark.hex | set_lightness: 55.0 | set_saturation: 55.0}}
palette = 9={{colors.primary_container.dark.hex | set_lightness: 70.0 | set_saturation: 45.0}}

# The other hues: neon. Full saturation, each as light as it can be while still
# vivid on true black (blue and magenta can't get lighter without fading). Yellow
# is turned from the wallpaper's orange (31) to gold (40) so it can glow too.
palette = 2={{colors.green.dark.hex | set_saturation: 100.0 | set_lightness: 60.0}}
palette = 3={{colors.yellow.dark.hex | set_hue: 40.0 | set_saturation: 100.0 | set_lightness: 55.0}}
palette = 4={{colors.blue.dark.hex | set_saturation: 100.0 | set_lightness: 70.0}}
palette = 5={{colors.magenta.dark.hex | set_saturation: 100.0 | set_lightness: 68.0}}
palette = 6={{colors.cyan.dark.hex | set_saturation: 100.0 | set_lightness: 55.0}}
palette = 10={{colors.green.dark.hex | set_saturation: 100.0 | set_lightness: 75.0}}
palette = 11={{colors.yellow.dark.hex | set_hue: 40.0 | set_saturation: 100.0 | set_lightness: 75.0}}
palette = 12={{colors.blue.dark.hex | set_saturation: 100.0 | set_lightness: 83.0}}
palette = 13={{colors.magenta.dark.hex | set_saturation: 100.0 | set_lightness: 83.0}}
palette = 14={{colors.cyan.dark.hex | set_saturation: 100.0 | set_lightness: 73.0}}
