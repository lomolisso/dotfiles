# vim: ft=dosini
# aerc styleset in the shin palette (structure from aerc's "blue" styleset):
# dark wine #8c1625 for borders, titles and the active tab, bright wine #cb4d66
# for selections and unread mail, greys and white for text. No backgrounds
# except selections, so the terminal's #000000 shows through.
*.default=true
*.normal=true

border.fg=#8c1625
title.bg=#8c1625
title.fg=#e9e9e9
title.bold=true
header.bold=true
header.fg=#cb4d66

tab.fg=#989898
tab.selected.fg=#e9e9e9
tab.selected.bg=#8c1625
tab.selected.bold=true

dirlist*.fg=#cfcfcf
dirlist*.selected.bg=#8c1625
dirlist*.selected.fg=#e9e9e9
dirlist*.selected.bold=true
dirlist_unread.fg=#cb4d66
dirlist_unread.bold=true

*error.bold=true
*error.fg=#cb4d66
*warning.fg=#ffb31a
*success.fg=#a2ff33

statusline_default.bg=#000000
statusline_default.fg=#cfcfcf
statusline_error.fg=#cb4d66

msglist_default.fg=#cfcfcf
msglist_unread.fg=#e9e9e9
msglist_unread.bold=true
msglist_read.fg=#989898
msglist_deleted.fg=#5c5c5c
msglist_flagged.fg=#cb4d66
msglist_*.selected.bg=#2a2a2a
msglist_*.selected.fg=#e9e9e9
msglist_marked.fg=#e9e9e9
msglist_marked.bg=#8c1625
msglist_marked.selected.fg=#e9e9e9
msglist_marked.selected.bg=#cb4d66
msglist_pill.reverse=true

part_*.fg=#cfcfcf
part_mimetype.fg=#8c1625
part_*.selected.fg=#e9e9e9
part_*.selected.bg=#8c1625
part_filename.selected.bold=true

selector_focused.bold=true
selector_focused.bg=#8c1625
selector_focused.fg=#e9e9e9
selector_chooser.bold=true
selector_chooser.bg=#cb4d66
selector_chooser.fg=#000000

default.selected.bold=true
default.selected.fg=#e9e9e9
default.selected.bg=#8c1625

completion_default.bg=#000000
completion_default.fg=#cfcfcf
completion_pill.reverse=true
completion_default.selected.bg=#8c1625
completion_default.selected.fg=#e9e9e9
completion_description.dim=true

[viewer]
*.default=true
*.normal=true
url.fg=#cb4d66
url.underline=true
header.fg=#8c1625
header.bold=true
signature.fg=#989898
diff_meta.fg=#e9e9e9
diff_meta.bold=true
diff_chunk.fg=#1aceff
diff_add.fg=#a2ff33
diff_del.fg=#cb4d66
diff_whitespace.bg=#8c1625
quote_1.fg=#cfcfcf
quote_2.fg=#989898
quote_3.fg=#5c5c5c
quote_x.fg=#5c5c5c
