  // --- syntax, from helix's shin theme ---
  "tokenColors": [
    { "scope": ["source", "text"], "settings": { "foreground": "#e9e9e9" } },
    {
      "name": "comment",
      "scope": ["comment", "punctuation.definition.comment", "string.quoted.docstring.multi.python"],
      "settings": { "foreground": "#5c5c5c", "fontStyle": "italic" }
    },
    {
      "name": "keyword",
      "scope": [
        "keyword",
        "keyword.control",
        "storage.type",
        "storage.modifier",
        "keyword.other.using",
        "keyword.other.import",
        "variable.language.this",
        "variable.language.self",
        "variable.language.super"
      ],
      "settings": { "foreground": "#cb4d66" }
    },
    {
      "name": "operator",
      "scope": ["keyword.operator", "storage.type.function.arrow"],
      "settings": { "foreground": "#cfcfcf" }
    },
    {
      "name": "keyword words that read like operators",
      "scope": ["keyword.operator.new", "keyword.operator.expression", "keyword.operator.logical.python", "keyword.operator.sizeof", "keyword.operator.cast"],
      "settings": { "foreground": "#cb4d66" }
    },
    {
      "name": "punctuation",
      "scope": [
        "punctuation",
        "meta.brace",
        "punctuation.separator",
        "punctuation.terminator",
        "punctuation.accessor",
        "meta.delimiter"
      ],
      "settings": { "foreground": "#989898" }
    },
    {
      "name": "punctuation.special: interpolation, decorators' @",
      "scope": [
        "punctuation.definition.template-expression",
        "punctuation.section.embedded",
        "punctuation.definition.interpolation"
      ],
      "settings": { "foreground": "#d5909e" }
    },
    {
      "name": "variable",
      "scope": ["variable", "variable.other", "meta.definition.variable"],
      "settings": { "foreground": "#e9e9e9" }
    },
    {
      "name": "parameter, member",
      "scope": [
        "variable.parameter",
        "meta.parameter",
        "variable.other.property",
        "variable.other.object.property",
        "variable.other.member",
        "meta.property-name",
        "support.type.property-name",
        "entity.name.tag.yaml",
        "support.type.property-name.json",
        "support.type.property-name.toml",
        "entity.other.attribute-name.class.css"
      ],
      "settings": { "foreground": "#cfcfcf" }
    },
    {
      "name": "builtin variables",
      "scope": ["variable.language", "support.variable", "variable.other.constant.builtin"],
      "settings": { "foreground": "#d5909e" }
    },
    {
      "name": "function",
      "scope": [
        "entity.name.function",
        "meta.function-call.generic",
        "support.function",
        "meta.function-call entity.name.function",
        "variable.function"
      ],
      "settings": { "foreground": "#668aff" }
    },
    {
      "name": "macro, preprocessor",
      "scope": [
        "entity.name.function.preprocessor",
        "entity.name.function.macro",
        "support.function.macro",
        "meta.preprocessor",
        "keyword.control.directive",
        "punctuation.definition.directive"
      ],
      "settings": { "foreground": "#d95cff" }
    },
    {
      "name": "type",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.name.struct",
        "entity.name.enum",
        "entity.name.union",
        "entity.name.trait",
        "entity.name.interface",
        "entity.other.inherited-class",
        "support.type",
        "support.class",
        "storage.type.primitive",
        "storage.type.built-in",
        "storage.type.cs",
        "storage.type.java",
        "storage.type.numeric.go",
        "storage.type.string.go",
        "storage.type.boolean.go",
        "storage.type.byte.go",
        "storage.type.error.go",
        "storage.type.rune.go",
        "storage.type.uintptr.go",
        "entity.name.type.parameter"
      ],
      "settings": { "foreground": "#ffb31a" }
    },
    {
      "name": "namespace, module",
      "scope": ["entity.name.namespace", "entity.name.module", "entity.name.type.module", "entity.name.scope-resolution", "storage.modifier.import", "storage.modifier.package"],
      "settings": { "foreground": "#d95cff" }
    },
    {
      "name": "constant",
      "scope": [
        "constant",
        "constant.numeric",
        "constant.language",
        "constant.other",
        "variable.other.constant",
        "variable.other.enummember",
        "support.constant",
        "entity.name.constant"
      ],
      "settings": { "foreground": "#d5909e" }
    },
    {
      "name": "escape",
      "scope": ["constant.character.escape", "constant.character.format", "constant.other.placeholder"],
      "settings": { "foreground": "#1aceff" }
    },
    {
      "name": "string",
      "scope": ["string", "string.quoted", "string.template", "punctuation.definition.string"],
      "settings": { "foreground": "#a2ff33" }
    },
    {
      "name": "regex, special strings",
      "scope": ["string.regexp", "constant.other.symbol", "string.other.link", "constant.other.character-class.regexp"],
      "settings": { "foreground": "#1aceff" }
    },
    {
      "name": "attribute, decorator",
      "scope": [
        "entity.other.attribute-name",
        "meta.decorator",
        "meta.attribute",
        "entity.name.function.decorator",
        "punctuation.definition.decorator",
        "meta.annotation",
        "storage.type.annotation"
      ],
      "settings": { "foreground": "#d95cff" }
    },
    {
      "name": "tag, label",
      "scope": ["entity.name.tag", "entity.name.label", "entity.name.section"],
      "settings": { "foreground": "#cb4d66" }
    },
    {
      "name": "html/jsx tag brackets",
      "scope": ["punctuation.definition.tag"],
      "settings": { "foreground": "#989898" }
    },
    {
      "name": "invalid",
      "scope": ["invalid", "invalid.illegal"],
      "settings": { "foreground": "#cb4d66", "fontStyle": "underline" }
    },
    {
      "name": "deprecated",
      "scope": ["invalid.deprecated"],
      "settings": { "foreground": "#989898", "fontStyle": "strikethrough" }
    },

    { "name": "markup heading", "scope": ["markup.heading", "markup.heading entity.name", "punctuation.definition.heading"], "settings": { "foreground": "#cb4d66", "fontStyle": "bold" } },
    { "name": "markup list", "scope": ["punctuation.definition.list.begin", "beginning.punctuation.definition.list"], "settings": { "foreground": "#8c1625" } },
    { "name": "markup bold", "scope": ["markup.bold"], "settings": { "fontStyle": "bold" } },
    { "name": "markup italic", "scope": ["markup.italic"], "settings": { "fontStyle": "italic" } },
    { "name": "markup strikethrough", "scope": ["markup.strikethrough"], "settings": { "fontStyle": "strikethrough" } },
    { "name": "markup link url", "scope": ["markup.underline.link", "string.other.link.description.title"], "settings": { "foreground": "#668aff", "fontStyle": "underline" } },
    { "name": "markup link text", "scope": ["string.other.link.title", "string.other.link.description", "meta.link.inline.markdown"], "settings": { "foreground": "#d5909e" } },
    { "name": "markup quote", "scope": ["markup.quote"], "settings": { "foreground": "#989898", "fontStyle": "italic" } },
    { "name": "markup raw", "scope": ["markup.inline.raw", "markup.fenced_code", "markup.raw"], "settings": { "foreground": "#a2ff33" } },

    { "name": "diff added", "scope": ["markup.inserted", "meta.diff.header.to-file"], "settings": { "foreground": "#a2ff33" } },
    { "name": "diff removed", "scope": ["markup.deleted", "meta.diff.header.from-file"], "settings": { "foreground": "#cb4d66" } },
    { "name": "diff changed", "scope": ["markup.changed", "meta.diff.range"], "settings": { "foreground": "#ffb31a" } }
  ],

  // Language servers' semantic tokens (rust-analyzer, clangd, Pylance, gopls, ...),
  // same mapping as above.
  "semanticTokenColors": {
    "comment": { "foreground": "#5c5c5c", "italic": true },
    "keyword": "#cb4d66",
    "selfKeyword": "#cb4d66",
    "selfTypeKeyword": "#ffb31a",
    "operator": "#cfcfcf",
    "variable": "#e9e9e9",
    "variable.defaultLibrary": "#d5909e",
    "variable.readonly": "#d5909e",
    "variable.constant": "#d5909e",
    "parameter": "#cfcfcf",
    "property": "#cfcfcf",
    "property.readonly": "#cfcfcf",
    "enumMember": "#d5909e",
    "function": "#668aff",
    "method": "#668aff",
    "function.defaultLibrary": "#668aff",
    "macro": "#d95cff",
    "decorator": "#d95cff",
    "attribute": "#d95cff",
    "derive": "#d95cff",
    "type": "#ffb31a",
    "class": "#ffb31a",
    "struct": "#ffb31a",
    "enum": "#ffb31a",
    "interface": "#ffb31a",
    "typeAlias": "#ffb31a",
    "typeParameter": "#ffb31a",
    "builtinType": "#ffb31a",
    "namespace": "#d95cff",
    "number": "#d5909e",
    "boolean": "#d5909e",
    "string": "#a2ff33",
    "escapeSequence": "#1aceff",
    "formatSpecifier": "#1aceff",
    "regexp": "#1aceff",
    "label": "#cb4d66",
    "lifetime": { "foreground": "#d5909e", "italic": true },
    "*.deprecated": { "strikethrough": true },
    "*.unsafe": { "underline": true }
  }
}
